<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>video-optimiser</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <!-- The LibraryImport source generator emits unsafe stubs; TerminalStyle uses it to switch on colour in the Windows console. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VideoOptimiser.Domain\VideoOptimiser.Domain.csproj" />
    <ProjectReference Include="..\VideoOptimiser.Application\VideoOptimiser.Application.csproj" />
    <ProjectReference Include="..\VideoOptimiser.Infrastructure\VideoOptimiser.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <!-- Draws the TUI (Features/Tui); AOT-clean, as the Trial A spike showed. Not Spectre.Console.Cli: the loop is our own. -->
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VideoOptimiser.UnitTests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(NuGetPackageRoot)sqlitepclraw.lib.e_sqlite3\$(SQLitePCLRawLibVersion)\runtimes\win-x64\native\e_sqlite3.dll" LogicalName="VideoOptimiser.Native.e_sqlite3.dll" />
  </ItemGroup>
  <Target Name="PrepareSingleFileAotPublish" AfterTargets="Publish">
    <ItemGroup>
      <PublishSymbols Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="$(PublishDir)e_sqlite3.dll;@(PublishSymbols)" />
  </Target>
</Project>
