<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- [LibraryImport] generates unsafe stubs (kernel32 calls for keep-awake and the detached launcher). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VideoOptimiser.Domain\VideoOptimiser.Domain.csproj" />
    <ProjectReference Include="..\VideoOptimiser.Application\VideoOptimiser.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="$(SQLitePCLRawLibVersion)" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
</Project>
